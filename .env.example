# ── Base de datos ─────────────────────────────────────────────────────────
# URL de la base de datos SQLite (Prisma crea el archivo si no existe).
DATABASE_URL="file:./certichain.db"
DATABASE_URL_PG=postgresql://postgres:admin@localhost:5432/certichain

# ── Kafka ─────────────────────────────────────────────────────────────────
# Lista de brokers separados por coma.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=certichain-api
# Consumer group del consumidor de correos (instancias con el mismo groupId se reparten particiones).
KAFKA_GROUP_ID=certichain-email-consumer
KAFKA_TOPIC=certificate.issued

# ── Correo (Mailpit local: sin auth) ──────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# URL pública base para el enlace de verificación incluido en el correo.
VERIFICATION_BASE_URL=http://localhost:3000/verify
