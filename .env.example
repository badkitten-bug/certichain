# URL de la base de datos SQLite.
# Prisma crea el archivo automáticamente si no existe.
DATABASE_URL="file:./certichain.db"

# Better Auth
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="genera-un-secreto-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Google — crear en https://console.cloud.google.com/
#   Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth GitHub — crear en https://github.com/settings/developers
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
