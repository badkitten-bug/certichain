# URL de la base de datos.
# Local/CI: SQLite (Prisma crea el archivo solo).
DATABASE_URL="file:./certichain.db"
# En staging (Dokploy) se usa PostgreSQL, p. ej.:
#   DATABASE_URL="postgresql://usuario:clave@host:5432/certichain"
#   DB_PROVIDER="postgresql"
# DB_PROVIDER por defecto es "sqlite"; el Dockerfile lo pone en "postgresql".

# RabbitMQ (eventos). Si NO está definida, se usa un publicador "noop"
# (local/CI funcionan sin broker). En el compose: amqp://rabbitmq:5672
# RABBITMQ_URL="amqp://localhost:5672"

# Better Auth
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="genera-un-secreto-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Google — crear en https://console.cloud.google.com/
#   Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth GitHub — crear en https://github.com/settings/developers
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
